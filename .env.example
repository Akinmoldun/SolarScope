# SolarScope environment variables.
#
# Copy this file to `.env.local` (never commit real values) and fill in what
# you need. All values below are placeholders, not secrets.

# Log level for the API server (pino): trace|debug|info|warn|error|fatal
LOG_LEVEL=info

# PostgreSQL connection string. Required only if you run the API server or
# Drizzle tooling (`pnpm --filter @workspace/db run push`).
# DATABASE_URL=postgres://user:password@localhost:5432/solarscope

# Frontend overrides (Vite defaults to PORT=5173, BASE_PATH=/)
# PORT=5173
# BASE_PATH=/
